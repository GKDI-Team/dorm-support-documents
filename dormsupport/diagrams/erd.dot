digraph G { graph [bgcolor="white",rankdir=LR,pad=0.4,nodesep=0.42,ranksep=0.8,fontname="Arial",splines=polyline]; node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=10,color="#000000",fontcolor="#000000",arrowsize=0.7];
User [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>User</B><BR/><FONT POINT-SIZE="11">Учётная запись</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">login UNIQUE · role</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">password_hash · activated_at</FONT></TD></TR></TABLE>>];
ActivationCode [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>ActivationCode</B><BR/><FONT POINT-SIZE="11">Одноразовый код</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id UUID PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">user_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">code_hash · expires_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">used_at? · revoked_at?</FONT></TD></TR></TABLE>>];
Block [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>Block</B><BR/><FONT POINT-SIZE="11">Корпус</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">name · address</FONT></TD></TR></TABLE>>];
Room [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>Room</B><BR/><FONT POINT-SIZE="11">Комната</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">block_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">number · UNIQUE(block,number)</FONT></TD></TR></TABLE>>];
Resident [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>Resident</B><BR/><FONT POINT-SIZE="11">Жилец</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">user_id PK / FK User</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">room_id FK</FONT></TD></TR></TABLE>>];
IssueCategory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>IssueCategory</B><BR/><FONT POINT-SIZE="11">Категория</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">name UNIQUE</FONT></TD></TR></TABLE>>];
IssueStatus [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>IssueStatus</B><BR/><FONT POINT-SIZE="11">Статус</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">code PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">NEW / IN_PROGRESS / CLOSED</FONT></TD></TR></TABLE>>];
Issue [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>Issue</B><BR/><FONT POINT-SIZE="11">Заявка</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">resident_id · room_id: ID references</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">category_id · status_code FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">room_number · block_name · address</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">title · description · location</FONT></TD></TR></TABLE>>];
IssueStatusHistory [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>IssueStatusHistory</B><BR/><FONT POINT-SIZE="11">История статусов</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id UUID PK = eventId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">issue_id · from_status? · to_status FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">changed_by: User ID reference</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">changed_at · published_at?</FONT></TD></TR></TABLE>>];
Notification [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#000000"><TR><TD BGCOLOR="#ffffff"><B>Notification</B><BR/><FONT POINT-SIZE="11">Доставка</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id UUID PK = eventId</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">issue_id: ID reference</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">event_payload · received_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">sent_at? · failed_at?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11">attempt_count · last_error?</FONT></TD></TR></TABLE>>];
subgraph cluster_identity {label="identity_db"; color="#000000"; User; ActivationCode; Block; Room; Resident;}
subgraph cluster_issues {label="issues_db"; color="#000000"; IssueCategory; IssueStatus; Issue; IssueStatusHistory;}
subgraph cluster_notifications {label="notifications_db"; color="black"; Notification;}
User -> ActivationCode [label="1:N", style="solid"];
Block -> Room [label="1:N", style="solid"];
Room -> Resident [label="1:N", style="solid"];
User -> Resident [label="1:1", style="solid"];
Resident -> Issue [label="1:N", style="dashed"];
Room -> Issue [label="1:N", style="dashed"];
IssueCategory -> Issue [label="1:N", style="solid"];
IssueStatus -> Issue [label="1:N", style="solid"];
Issue -> IssueStatusHistory [label="1:N", style="solid"];
IssueStatus -> IssueStatusHistory [label="1:N", style="solid"];
User -> IssueStatusHistory [label="1:N", style="dashed"];
IssueStatusHistory -> Notification [label="1:1", style="dashed"];
}