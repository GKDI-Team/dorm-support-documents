erDiagram
    User ||--o{ ActivationCode : "1:N"
    User ||..o{ Issue : "1:N reference"
    IssueCategory ||--o{ Issue : "1:N"
    IssueStatus ||--o{ Issue : "1:N"
    Issue ||--|{ IssueStatusHistory : "1:N"
    User ||..o{ IssueStatusHistory : "1:N reference"
    IssueStatus ||--o{ IssueStatusHistory : "1:N"
    IssueStatus o|--o{ IssueStatusHistory : "1:N"
    IssueStatusHistory ||..o| Notification : "1:1 reference"
    User {
        uuid id PK
        string login UK
        string full_name
        string role
        string password_hash
        string block
        string room_number
        datetime activated_at
        datetime created_at
    }
    ActivationCode {
        uuid id PK
        uuid user_id FK
        string code_hash
        datetime expires_at
        datetime used_at
        datetime revoked_at
        datetime created_at
    }
    IssueCategory {
        uuid id PK
        string name UK
    }
    IssueStatus {
        string code PK
        string name
    }
    Issue {
        uuid id PK
        uuid resident_id
        string room_number
        uuid category_id FK
        string status_code FK
        string title
        string description
        string location_details
        datetime created_at
        datetime updated_at
        string block
    }
    IssueStatusHistory {
        uuid id PK
        uuid issue_id FK
        string from_status FK
        string to_status FK
        uuid changed_by
        datetime changed_at
        datetime published_at
    }
    Notification {
        uuid id PK
        uuid issue_id
        string event_type
        json event_payload
        datetime occurred_at
        datetime received_at
        datetime sent_at
        datetime failed_at
        int attempt_count
        string last_error
    }
