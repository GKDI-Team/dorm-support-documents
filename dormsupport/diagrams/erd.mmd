erDiagram
    %% identity_db
    blocks ||--o{ rooms : "1:N"
    rooms o|--o{ users : "1:N"
    users o|--o{ auth_audit_log : "1:N"

    %% issues_db
    issue_categories ||--o{ issues : "1:N"
    issue_statuses ||--o{ issues : "1:N"
    issues ||--o{ issue_status_history : "1:N"
    issue_statuses o|--o{ issue_status_history : "from_status_id"
    issue_statuses ||--o{ issue_status_history : "to_status_id"
    issues ||--o{ issue_events : "1:N"

    %% Логические ссылки между базами, без SQL FK
    users ||..o{ issues : "1:N resident_id"
    users ||..o{ issue_status_history : "1:N changed_by"
    issue_events ||..o{ notifications : "1:N event_id"

    blocks {
        uuid id PK
        varchar_50 name UK
        varchar_255 address
    }
    rooms {
        uuid id PK
        uuid block_id FK
        varchar_20 number
    }
    users {
        uuid id PK
        varchar_64 login UK
        text password_hash
        varchar_150 full_name
        varchar_20 role
        uuid room_id FK "nullable"
        timestamptz created_at
    }
    auth_audit_log {
        uuid id PK
        uuid user_id FK "nullable"
        varchar_64 login
        varchar_40 action
        boolean success
        text failure_reason "nullable"
        timestamptz created_at
    }
    issue_statuses {
        uuid id PK
        varchar_30 code UK
        varchar_50 name
        text description
    }
    issue_categories {
        uuid id PK
        varchar_80 name UK
        text description
    }
    issues {
        uuid id PK
        uuid resident_id "логическая ссылка на users.id"
        varchar_50 block
        varchar_20 room_number
        varchar_150 title
        text description
        uuid category_id FK
        uuid status_id FK
        varchar_250 location_details
        timestamptz created_at
        timestamptz updated_at
    }
    issue_status_history {
        uuid id PK
        uuid issue_id FK
        uuid from_status_id FK "nullable"
        uuid to_status_id FK
        uuid changed_by "логическая ссылка на users.id"
        timestamptz changed_at
    }
    issue_events {
        uuid id
        uuid event_id
        uuid issue_id
        varchar event_type
        text payload
        varchar status
        timestamptz created_at
        timestamptz published_at
        text last_error
    }
    notifications {
        uuid id PK
        uuid event_id "логическая ссылка на issue_events.event_id"
        varchar event_type
        uuid issue_id
        varchar status
        varchar previous_status
        timestamptz occurred_at
        varchar title
        text description_preview
        varchar block
        varchar room_number
        varchar location_details
        varchar category_name
        varchar delivery_status
        text delivery_error
        timestamptz sent_at
        timestamptz created_at
    }
