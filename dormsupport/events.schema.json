{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dormsupport.example/schemas/issue-events-v1.json",
  "title": "DormSupport issue events v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventVersion",
        "type",
        "occurredAt",
        "data"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventVersion": {
          "const": 1
        },
        "type": {
          "const": "issue.created"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issueId",
            "categoryName",
            "status",
            "title",
            "descriptionPreview",
            "blockName",
            "roomNumber",
            "locationDetails"
          ],
          "properties": {
            "issueId": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "categoryName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "status": {
              "const": "NEW"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "descriptionPreview": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "Описание целиком до 500 символов; иначе первые 499 символов и многоточие. Полное описание доступно в списке заявок."
            },
            "blockName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "roomNumber": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "locationDetails": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "eventVersion",
        "type",
        "occurredAt",
        "data"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "eventVersion": {
          "const": 1
        },
        "type": {
          "const": "issue.status_changed"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issueId",
            "oldStatus",
            "newStatus"
          ],
          "properties": {
            "issueId": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "oldStatus": {
              "type": "string",
              "enum": [
                "NEW",
                "IN_PROGRESS",
                "CLOSED"
              ]
            },
            "newStatus": {
              "type": "string",
              "enum": [
                "NEW",
                "IN_PROGRESS",
                "CLOSED"
              ]
            }
          },
          "oneOf": [
            {
              "properties": {
                "oldStatus": {
                  "const": "NEW"
                },
                "newStatus": {
                  "const": "IN_PROGRESS"
                }
              }
            },
            {
              "properties": {
                "oldStatus": {
                  "const": "IN_PROGRESS"
                },
                "newStatus": {
                  "const": "CLOSED"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
